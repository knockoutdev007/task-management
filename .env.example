# Copy to .env and edit. Never commit .env.

# Signs session cookies. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=CHANGE_ME_min_24_chars_random

# MySQL connection. Create the database and a user for it first — see
# README.md's deploy section for the CREATE DATABASE / CREATE USER commands.
DATABASE_URL=mysql://tcc_app:CHANGE_ME@127.0.0.1:3306/tcc

# Where uploaded task attachments live (data/uploads under this directory).
# Must be on a persistent disk in production — this is separate from the
# database and isn't covered by a mysqldump backup.
DATA_DIR=./data

PORT=3000
NODE_ENV=production

# How long a login lasts.
SESSION_DAYS=14

# Number of proxies in front of the app (nginx, a platform router). 0 if none.
TRUST_PROXY=1

# Set to 1 ONLY if you are running production over plain HTTP on a private
# network. It drops the Secure flag from the session cookie.
# INSECURE_COOKIES=0
