{
  "name": "team-control-center",
  "version": "1.0.0",
  "private": true,
  "description": "Internal team task tracker and management dashboard",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "seed:reset": "node --env-file-if-exists=.env scripts/seed.js --reset",
    "create-manager": "node --env-file-if-exists=.env scripts/create-manager.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "test": "node --env-file-if-exists=.env scripts/smoke-test.js && node scripts/notif-test.js",
    "test:notif": "node scripts/notif-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.1",
    "multer": "^2.3.0"
  }
}
